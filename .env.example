# Example Environment Variables for Deployment (Vercel, Railway, VPS, cPanel)

# Database: SQLite for local/VPS or PostgreSQL/MySQL for Vercel/Railway
DATABASE_URL="file:./dev.db"

# Public site domain URL (e.g., https://zakovat.uz or https://your-domain.vercel.app)
NEXTAUTH_URL="https://your-domain.com"

# Random 32+ character string for JWT session encryption
NEXTAUTH_SECRET="generate-a-secure-random-32-char-secret-key-here"

NODE_ENV="production"
